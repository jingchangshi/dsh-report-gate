{
  "name": "dsh-report-gate",
  "version": "0.1.2",
  "description": "Readability gate for AI task reports: catch undefined internal labels and jargon before a report reaches a human (DSH plugin + standalone CLI).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "report-gate": "src/cli.js"
  },
  "exports": {
    ".": "./src/dsh/index.js",
    "./engine": "./src/engine.js",
    "./config": "./src/config.js"
  },
  "files": [
    "src",
    "packs",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo": "node src/cli.js check test/fixtures/session-sample.jsonl --lang zh"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "yaml": "2.8.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.3",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3"
  }
}